# ─── Environment files (NEVER commit secrets) ────────────────────────────────
.env
.env.*
*.env
server/.env
server/.env.*
client/.env
client/.env.*
!.env.example
!server/.env.example
!client/.env.example

# ─── Node.js Dependencies ────────────────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Build output ────────────────────────────────────────────────────────────
client/build/
client/dist/
server/dist/
build/
dist/

# ─── Uploads & User Media ────────────────────────────────────────────────────
uploads/*
server/uploads/*
server/uploads/avatars/*
!server/uploads/avatars/.gitkeep
tmp/

# ─── OS / editor artifacts ───────────────────────────────────────────────────
*.zip
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── MongoDB local data ───────────────────────────────────────────────────────
data/
