{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "eventsphere-client": {
      "root": "client"
    },
    "eventsphere-api": {
      "root": "server"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": {
        "service": "eventsphere-api",
        "path": "/api/:match*"
      }
    },
    {
      "source": "/uploads/:match*",
      "destination": {
        "service": "eventsphere-api",
        "path": "/uploads/:match*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "eventsphere-client"
      }
    }
  ]
}
