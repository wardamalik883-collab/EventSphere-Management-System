# ─────────────────────────────────────────────────────────────────────────────
#  EventSphere Management — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Node environment ────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# MongoDB Atlas Connection String Format:
# Replace <db_username>, <db_password>, and <cluster-url> with your Atlas cluster details.
# Note: Ensure special characters in password are URL encoded (e.g., @ as %40).
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>.mongodb.net/eventsphere?retryWrites=true&w=majority

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:3000,https://eventsphere.vercel.app

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=30d

# ─── Upload limits & background scheduler ────────────────────────────────────
MAX_FILE_SIZE_MB=5
REMINDER_WINDOW_HOURS=24

# ─── Client (Frontend) ───────────────────────────────────────────────────────
# In production, set to your deployed backend URL:
REACT_APP_API_URL=https://eventsphere-api.onrender.com
